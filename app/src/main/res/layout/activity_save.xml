<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro / Edición de Producto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etSKU"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU / Código del Producto"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del Producto"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Categoría"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marca"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Modelo"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etUnidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidades en Existencia"
            android:inputType="number"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPuntoReorden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Punto de Reorden (Stock Mínimo)"
            android:inputType="number"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción detallada"
            android:inputType="textMultiLine"
            android:lines="3"
            android:layout_marginBottom="16dp" />

        <!-- Carga de Imágenes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imágenes del Producto (Mínimo 2)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivImg1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_camera"
                android:background="#E0E0E0"
                android:layout_marginEnd="12dp"
                android:contentDescription="Imagen 1" />

            <ImageView
                android:id="@+id/ivImg2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_camera"
                android:background="#E0E0E0"
                android:contentDescription="Imagen 2" />
        </LinearLayout>

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnGuardarBorrador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar como Borrador"
            android:backgroundTint="#757575"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar Producto"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnVolverSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al Menú"
            android:backgroundTint="#D32F2F" />

    </LinearLayout>
</ScrollView>